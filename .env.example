# ==============================================================================
# SOAR 2026 EVENT OPERATING SYSTEM — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development or set in Vercel / server environment.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Relational Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://soar_user:soar_secure_password@localhost:5432/soar_2026_db

# Cryptographic Token & Offline Manifest Signing Secret (HMAC-SHA256)
EVENT_SECURITY_SECRET=replace_with_strong_random_secret_at_least_64_chars_long

# Administrative Session & Authentication Secret (HMAC-SHA256)
SESSION_SECRET=replace_with_strong_session_salt_at_least_64_chars_long

# Paystack Payment Gateway Integration (Optional for free registrations)
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public_key

# Event Telemetry & Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
